# Banco: omita DATABASE_URL para usar PGlite local em .data/pglite
DATABASE_URL=postgresql://manuauto:troque_esta_senha@localhost:5432/manuauto
PGLITE_DATA_DIR=./.data/pglite
ALLOW_PGLITE_PRODUCTION=false

# Autenticação própria
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=gere_com_openssl_rand_base64_32
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Arquivos: local no desenvolvimento; s3 para R2, MinIO ou AWS
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/uploads
ALLOW_LOCAL_STORAGE_PRODUCTION=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=manuauto
S3_ACCESS_KEY_ID=defina_no_servidor
S3_SECRET_ACCESS_KEY=defina_no_servidor
S3_FORCE_PATH_STYLE=true

# E-mail SMTP; sem SMTP, links são impressos no log apenas em desenvolvimento
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Manuauto <nao-responda@localhost>

# IA opcional compatível com o formato OpenAI
AI_BASE_URL=
AI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4.1-mini
